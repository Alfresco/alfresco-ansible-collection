{%- macro escape(value) -%}
{{ value | string | replace('\\', '\\\\') | replace('\n', '\\n') | replace('\r', '\\r') | regex_replace('^([ \t\f])', '\\\\\\1') }}
{%- endmacro -%}
# {{ ansible_managed }}
ldap.authentication.active=false
ldap.authentication.java.naming.provider.url={{ escape(repository_ldap_ad.url) }}
ldap.synchronization.active=true
ldap.synchronization.java.naming.security.authentication={{ escape(repository_ldap_ad.bind_authentication) }}
ldap.synchronization.java.naming.security.principal={{ escape(repository_ldap_ad.bind_principal) }}
ldap.synchronization.java.naming.security.credentials={{ escape(repository_ldap_ad.bind_password) }}
ldap.synchronization.userSearchBase={{ escape(repository_ldap_ad.user_search_base) }}
ldap.synchronization.groupSearchBase={{ escape(repository_ldap_ad.group_search_base) }}
{% for key, value in repository_ldap_ad.extra_properties | dictsort %}
{{ key }}={{ escape(value) }}
{% endfor %}
